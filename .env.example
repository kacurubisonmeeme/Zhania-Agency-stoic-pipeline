# Stoic Shorts Pipeline — Environment Variables Template
# Copy this file to .env and fill in your actual API keys.

# Gemini API Key (required for script generation & vision re-ranking)
# Supports rotation: GEMINI_API_KEY_1, GEMINI_API_KEY_2, etc.
GEMINI_API_KEY=your_gemini_api_key_here

# Pexels API Key (required for b-roll stock footage search)
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay API Key (optional secondary source for b-roll stock footage)
PIXABAY_API_KEY=your_pixabay_api_key_here
